# Copy to .env and fill in. Never commit .env.

# MySQL 8 database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=notifyflow
DB_PASSWORD=change-me
DB_NAME=notifyflow

# Required: a long random string (at least 32 characters), e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Public address of the web UI (used for links inside mails and for the Socket.IO origin check)
FRONTEND_BASE_URL=http://localhost:3100
# Extra browser origins allowed to call the API directly (comma separated). Leave empty behind a proxy.
CORS_ORIGINS=

# console = only write mails to the log (demo); smtp = really send
MAIL_MODE=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=notifyflow@example.com

# Hosts a template may fetch mail attachments from (comma separated). Empty = any public host.
ATTACHMENT_ALLOWED_HOSTS=
ATTACHMENT_MAX_BYTES=10485760

# Where uploaded to-do files are kept, and the size limit
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

# Used once by scripts/init_db.py to create the first administrator
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
